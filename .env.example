# Пример локального окружения. Скопируйте в .env и заполните своими значениями.
#
# .env в .gitignore и в репозиторий не попадает. Настоящие ключи сюда
# не вписывайте: этот файл публичный.

# Ключ деплоера: создаёт контракты и пулы.
# Создаётся командой: node scripts/create-wallet.mjs
DEPLOYER_KEY=

# Ключ кошелька-получателя: сюда выводятся средства с биржи и из бота.
# Отдельный от DEPLOYER_KEY, чтобы утечка одного не открывала второй.
# Создаётся командой: node scripts/create-receiver.mjs
RECEIVER_KEY=

# Ключ владельца NFT-позиций (если выводите из Pancake).
# Только для scripts/nft-exit.mjs. Храните отдельно от остальных.
PRIVATE_KEY=

# RPC для чтения. Отправка всегда идёт через
# https://bscrpc.pancakeswap.finance (MEV-guard), его менять не нужно.
BSC_RPC=https://bsc-rpc.publicnode.com

# Ключ Etherscan V2 API для верификации контрактов.
# BNB Chain там указывается как chainid=56.
ETHERSCAN_API_KEY=