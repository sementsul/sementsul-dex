# Зависимости
node_modules/

# Сборка фронтенда
dist/

# Сборка Foundry
foundry-out/
cache/
out/

# Зависимости Foundry. Ставятся командой `forge install`; в репозитории им
# не место — это чужой код, и его версия должна быть зафиксирована, а не
# скопирована.
lib/

# Артефакты тестовых прогонов
.bak

# Локальные файлы окружения с ключами. Приватный ключ деплоера и токен
# Cloudflare не должны попадать в репозиторий ни при каких условиях.
.env
.env.*
!.env.example

# Служебное
.DS_Store
Thumbs.db
*.log

# Кэши инструментов: восстанавливаются сами, в репозитории только мешают.
.npm-cache/
.wrangler/
node_modules/.vite/

# Секреты, которые могли случайно оказаться рядом. Файл .env уже закрыт выше;
# эти строки — на случай, если кто-то положит ключ в другое имя.
*.pem
*.key
!public/*.png