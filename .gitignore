# Зависимости
node_modules/

# Сборка фронтенда
dist/

# Сборка Foundry
foundry-out/
cache/
out/

# Зависимости Foundry. Ставятся командой `forge install`; в репозитории им
# не место — это чужой код, и его версия должна быть зафиксирована, а не
# скопирована.
#
# Шаблон привязан к корню намеренно. Без ведущего слэша `lib/` совпадал с
# любой папкой lib на любом уровне и молча выкидывал из репозитория весь
# src/lib/ — а это половина логики фронтенда. Ошибка не видна: файлы лежат
# на диске, тесты проходят, а в git их нет и на чистом клоне сайт не соберётся.
/lib/

# Артефакты тестовых прогонов
.bak

# Локальные файлы окружения с ключами. Приватный ключ деплоера и токен
# Cloudflare не должны попадать в репозиторий ни при каких условиях.
.env
.env.*
!.env.example

# Служебное
.DS_Store
Thumbs.db
*.log

# Кэши инструментов: восстанавливаются сами, в репозитории только мешают.
.npm-cache/
.wrangler/
node_modules/.vite/

# Секреты, которые могли случайно оказаться рядом. Файл .env уже закрыт выше;
# эти строки — на случай, если кто-то положит ключ в другое имя.
*.pem
*.key
!public/*.png

# Выгруженный бандл воркера lp-ladder: 4 МБ в одну строку. Нужен только для
# разбора чужого кода, в репозитории места не занимает ничего полезного.
_worker-dump/

# Скриншоты для визуальной проверки: генерируются скриптом, в репозитории не нужны.
.screens/

# локальная подпись, не для репозитория
.sign-ownership.json

# снимок DNS-записей перед миграцией почты: содержит id записей, для репозитория не нужен
.dns-backup-yandex.json
